enum Side {
  buy
  sell
}

enum Type {
  maker
  taker
}

enum Status {
  placed
  cancelled
  partiallyFilled
  executed
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id @default(uuid())
  username   String   @unique
  password   String
  usdBal     Int      @default(0)
  lockedBal  Int      @default(0)

  orders     Order[]
  balance    Balance[]
  fills      Fills[]
}

model Asset {
  id         String   @id @default(uuid())
  name       String
  Symbol     String

  orders     Order[]
  fills      Fills[]
  balance    Balance[]

  candles1m  Candle_1m[]
  candles15m Candle_15m[]
  candles1h  Candle_1h[]
}

model Order {
  id         String   @id @default(uuid())
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id])

  userId     String
  user       User     @relation(fields: [userId], references: [id])

  side       Side
  price      Int
  qty        Int
  type       Type
  created_at DateTime
  filledQty  Int      @default(0)
  status     Status

  fills      Fills[]
}

model Fills {
  id         String   @id @default(uuid())

  userId     String
  user       User     @relation(fields: [userId], references: [id])

  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])

  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id])

  filledQty  Int      @default(0)
  side       Side
  type       Type
  price      Int
  filled_at  DateTime
}

model Balance {
  id         String   @id @default(uuid())

  userId     String
  user       User     @relation(fields: [userId], references: [id])

  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id])

  qty        Int
  lockedQty  Int      @default(0)
}

model Candle_1m {
  id         String   @id @default(uuid())

  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id])

  timestamp  DateTime
  volume     Int
  H          Int
  L          Int
  O          Int
  C          Int
}

model Candle_15m {
  id         String   @id @default(uuid())

  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id])

  timestamp  DateTime
  volume     Int
  H          Int
  L          Int
  O          Int
  C          Int
}

model Candle_1h {
  id         String   @id @default(uuid())

  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id])

  timestamp  DateTime
  volume     Int
  H          Int
  L          Int
  O          Int
  C          Int
}